# ---------------------------------------------------------------
# Copy this file to ".env.local" for local development.
# On Vercel, add the same names under Project > Settings > Environment Variables.
# ---------------------------------------------------------------

# REQUIRED: Postgres connection string (from Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# REQUIRED: a long random secret used to sign login sessions.
# Make one at https://generate-secret.vercel.app/32  (or run: openssl rand -base64 32)
NEXTAUTH_SECRET="paste-a-long-random-string-here"

# Local only: the address of your dev server. Not needed on Vercel.
NEXTAUTH_URL="http://localhost:3000"

# REQUIRED for your first admin: whoever signs up with this email becomes ADMIN.
# You can list several, separated by commas.
ADMIN_EMAIL="you@example.com"

# RECOMMENDED: your email, sent politely to the free paper databases.
CONTACT_EMAIL="you@example.com"

# OPTIONAL: free OpenAlex key (better search, abstracts, open-access filter).
# Get it at https://openalex.org/settings/api . Without it, search uses Crossref.
OPENALEX_API_KEY=""

# OPTIONAL: Anthropic API key for AI summaries. Without it, a built-in
# "key sentences" summary is used instead. https://console.anthropic.com
ANTHROPIC_API_KEY=""
